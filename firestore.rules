rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 合言葉（20文字のランダム文字列）を知っている人だけが読み書きできる。
    // 一覧取得（list）は許可しないので、他人の合言葉を探すことはできない。
    match /rooms/{roomId} {
      allow get, create, update: if request.auth != null && roomId.size() >= 16;

      match /items/{itemId} {
        allow read, delete: if request.auth != null && roomId.size() >= 16;
        allow create, update: if request.auth != null && roomId.size() >= 16
          && request.resource.data.amount is int
          && request.resource.data.amount >= 0
          && request.resource.data.type in ['income', 'expense'];
      }
    }
  }
}
